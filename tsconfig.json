{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "@nexlet/plugin-api"
    ]
  },
  "include": [
    "plugins/**/*.ts",
    "templates/**/*.ts",
    "tests/types/**/*.ts"
  ],
  "exclude": [
    "**/src/backend.ts",
    "plugins/ocr/**"
  ]
}
