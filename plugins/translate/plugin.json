{
  "id": "org.nexlet.translate",
  "name": "翻译",
  "version": "1.1.0",
  "description": "Google 免 Key 翻译与可配置的 LLM 翻译，支持自动识别语言、段落翻译和一键复制。",
  "apiVersion": 1,
  "main": "index.html",
  "icon": "icon.png",
  "permissions": [
    "clipboard.write",
    "network.request",
    "secrets"
  ],
  "features": [
    {
      "code": "translate",
      "name": "翻译",
      "keywords": [
        "翻译",
        "translate",
        "translation",
        "fanyi",
        "fy",
        "Google",
        "LLM"
      ],
      "matches": [
        {
          "type": "text",
          "minLength": 1,
          "maxLength": 10000
        }
      ]
    }
  ]
}
