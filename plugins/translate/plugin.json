{
  "id": "org.nexlet.translate",
  "name": "翻译",
  "version": "1.2.0",
  "description": "Google 免 Key 翻译与可配置的 LLM 翻译，支持自动识别语言、段落翻译和一键复制。",
  "apiVersion": 1,
  "main": "index.html",
  "icon": "icon.png",
  "permissions": [
    "clipboard.write",
    "network.request",
    "secrets"
  ],
  "features": [
    {
      "code": "translate",
      "name": "翻译",
      "keywords": [
        "翻译",
        "translate",
        "translation",
        "fanyi",
        "fy",
        "Google",
        "LLM"
      ],
      "matches": [
        {
          "type": "text",
          "minLength": 1,
          "maxLength": 10000
        }
      ],
      "locales": {
        "en": {
          "name": "Translate"
        },
        "zh-Hant": {
          "name": "翻譯"
        }
      }
    }
  ],
  "locales": {
    "en": {
      "name": "Translate",
      "description": "Translate with Google or a configurable LLM service"
    },
    "zh-Hant": {
      "name": "翻譯",
      "description": "使用 Google 或自訂 LLM 服務翻譯"
    }
  }
}
