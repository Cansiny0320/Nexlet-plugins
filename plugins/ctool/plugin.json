{
  "id": "org.nexlet.ctool",
  "name": "Ctool 开发工具箱",
  "version": "1.0.0",
  "description": "集成 Ctool 完整开发工具：加解密、编码、JSON、代码、网络、图像、文本与转换。联网请求由插件后台执行。",
  "apiVersion": 1,
  "main": "tool.html",
  "backend": "backend.cjs",
  "icon": "icon.png",
  "permissions": ["backend", "files", "clipboard.read", "clipboard.write", "shell.openExternal", "secrets"],
  "features": [
    { "code": "ctool", "name": "Ctool 开发工具箱", "keywords": ["ctool", "开发工具", "工具箱"] },
    { "code": "json", "name": "Ctool JSON", "keywords": ["ctool json", "json 格式化"], "matches": [{ "type": "text" }] },
    { "code": "hash", "name": "Ctool 哈希", "keywords": ["hash", "md5", "sha256", "哈希"] },
    { "code": "aes", "name": "Ctool 加密解密", "keywords": ["aes", "加密", "解密", "rsa", "sm2", "sm4"] },
    { "code": "base64", "name": "Ctool Base64", "keywords": ["base64", "编码"] },
    { "code": "url", "name": "Ctool URL 编解码", "keywords": ["url", "url encode"] },
    { "code": "time", "name": "Ctool 时间", "keywords": ["时间戳", "timestamp", "时区", "时间计算"] },
    { "code": "qrCode", "name": "Ctool 二维码", "keywords": ["二维码", "qrcode", "二维码解析"] },
    { "code": "barcode", "name": "Ctool 条形码", "keywords": ["条形码", "barcode"] },
    { "code": "regex", "name": "Ctool 正则表达式", "keywords": ["regex", "正则"] },
    { "code": "code", "name": "Ctool 代码工具", "keywords": ["代码格式化", "代码运行", "code", "prettier"] },
    { "code": "diffs", "name": "Ctool 文本差异", "keywords": ["diff", "文本对比"] },
    { "code": "serialize", "name": "Ctool 序列化转换", "keywords": ["yaml", "xml", "序列化", "toml"] },
    { "code": "text", "name": "Ctool 文本处理", "keywords": ["文本处理", "去重", "大小写"] },
    { "code": "ip", "name": "Ctool IP 查询", "keywords": ["ip", "IP 地址查询"] },
    { "code": "ipcalc", "name": "Ctool IP 网络计算", "keywords": ["ipcalc", "子网", "ipv6"] },
    { "code": "websocket", "name": "Ctool WebSocket", "keywords": ["websocket", "ws", "wss"] },
    { "code": "arm", "name": "Ctool ARM / HEX", "keywords": ["arm", "hex", "汇编"] },
    { "code": "httpSnippet", "name": "Ctool HTTP 代码生成", "keywords": ["curl", "http", "请求代码"] },
    { "code": "crontab", "name": "Ctool Cron", "keywords": ["cron", "crontab", "定时规则"] },
    { "code": "unit", "name": "Ctool 单位换算", "keywords": ["单位换算", "unit"] },
    { "code": "uuid", "name": "Ctool UUID", "keywords": ["uuid", "ulid"] },
    { "code": "jwt", "name": "Ctool JWT", "keywords": ["jwt", "token 解码"] },
    { "code": "bcrypt", "name": "Ctool Bcrypt", "keywords": ["bcrypt", "密码校验"] },
    { "code": "sign", "name": "Ctool 签名", "keywords": ["签名", "sign"] },
    { "code": "pinyin", "name": "Ctool 拼音", "keywords": ["拼音", "pinyin"] },
    { "code": "radix", "name": "Ctool 进制转换", "keywords": ["进制", "radix"] },
    { "code": "color", "name": "Ctool 颜色", "keywords": ["颜色", "color"] },
    { "code": "dockerCompose", "name": "Ctool Docker Compose", "keywords": ["docker", "compose"] },
    { "code": "dataValidation", "name": "Ctool 数据校验", "keywords": ["crc", "bcc", "lrc", "校验"] }
  ]
}
