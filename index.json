      "name": "离线 OCR",
      "description": "本机识别图片和截图中的中英文文字。模型随插件提供，无需联网。",
      "version": "1.2.0",
      "author": "Nexlet",
      "category": "效率",
      "platforms": [
        "win32",
        "darwin",
        "linux"
